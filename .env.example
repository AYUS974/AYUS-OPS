# --- Supabase (Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Anon (public) key — used to verify dashboard logins and by the React app
SUPABASE_ANON_KEY=your-anon-key

# --- LLM provider: anthropic | gemini | groq ---
# NOTE: this selects the brain for the daily AGENTS. The AYUS chat + live voice
# assistant is powered by GROQ (fast) with a GEMINI fallback — so for AYUS to
# talk you need GROQ_API_KEY (recommended) and/or GEMINI_API_KEY set below,
# regardless of LLM_PROVIDER.
LLM_PROVIDER=anthropic
# Per-task model routing — "jaisa task, waisa model". The Mission Control builder
# writes real, runnable code, which needs a stronger model than a cheap chat
# default. Route just the "code" tier here; everything else uses LLM_PROVIDER.
# Defaults to Groq when GROQ_API_KEY is set. e.g. LLM_PROVIDER_CODE=anthropic
# LLM_PROVIDER_CODE=groq

# --- Anthropic API (console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used by all agents. Sonnet is a good cost/quality default.
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Gemini API (aistudio.google.com — has a free tier) ---
# Only needed when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Live voice-to-voice (real-time speech-to-speech via Gemini Live). Off by default;
# set to true to use it instead of the turn-based Whisper→LLM→TTS path. Needs GEMINI_API_KEY.
GEMINI_LIVE_ENABLED=false
# Google renames Live models often — override if the socket 404s on connect.
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview

# --- Porcupine keyword interrupt ("say AYUS to cut in") ---
# Local, offline wake-word spotting (works in Electron, unlike Web Speech). Lets
# you interrupt AYUS's turn-based reply by voice. Empty = feature off.
#   1. Get a free access key at console.picovoice.ai
#   2. Drop the base model at web/public/porcupine_params.pv (from Picovoice)
#   3. Optional: train an "AYUS" wake word (.ppn, Web/WASM) → web/public/ayus.ppn
#      Without it, the trigger word is the built-in "Jarvis".
PICOVOICE_ACCESS_KEY=

# --- Groq API (console.groq.com — fast, has a free tier) ---
# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Voice input: the GROQ_API_KEY above also powers speech-to-text (Whisper),
# which is how the mic works in every browser (not just Chrome/Edge).
GROQ_STT_MODEL=whisper-large-v3-turbo
# Pin the spoken language so Whisper stops guessing wrong ones (e.g. Swedish).
# "en" = English (handles a few Hindi words); "hi" = Hindi/Devanagari; blank = auto-detect.
GROQ_STT_LANGUAGE=en
# Optional context prompt that biases Whisper's vocabulary/style (names, Hinglish).
GROQ_STT_PROMPT=

# --- Email (resend.com — optional) ---
# Leave RESEND_API_KEY empty and approved emails are printed to the server
# console instead of actually sent (still logged to sent_emails).
RESEND_API_KEY=
# Must be a verified sender/domain in Resend. The resend.dev address works for testing.
EMAIL_FROM="AYUS Labs <onboarding@resend.dev>"

# --- AYUS's laptop access (semicolon-separated folders, READ/OPEN only) ---
# PC_ALLOWED_DIRS=F:\AYUS Labs;C:\Users\you\Desktop;C:\Users\you\Downloads;C:\Users\you\Documents

# --- Voice (optional) ---
# Without a key, the dashboard uses free browser voices automatically.
# Provider chain: Sarvam (primary) → Cartesia → ElevenLabs → free browser voices.
# Sarvam (sarvam.ai) is best for Hinglish — its Bulbul model code-switches
# Hindi/English natively. Get a key at dashboard.sarvam.ai.
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
# Per-agent voice overrides (bulbul:v3 speakers): SARVAM_VOICE_AYUS, SARVAM_VOICE_SALES, etc.
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# --- Google: Gmail + Calendar (optional but powerful) ---
# console.cloud.google.com → enable "Gmail API" + "Google Calendar API" →
# OAuth consent (External, add yourself as a test user) → Credentials →
# OAuth client ID (Web application). Add this redirect URI:
#   http://localhost:3000/api/google/callback
# Then click "Connect Google" in the dashboard side panel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only override if you deploy somewhere other than localhost:3000
# GOOGLE_REDIRECT_URI=https://your-app.com/api/google/callback
# APP_BASE_URL=https://your-app.com

# --- Spotify: real "play this exact song" (optional, needs Premium) ---
# developer.spotify.com → Create app → copy Client ID/Secret. In the app's
# settings add this exact Redirect URI (Spotify rejects 'localhost'):
#   http://127.0.0.1:3000/api/spotify/callback
# Then click "Connect Spotify" in the dashboard side panel. Premium is required
# for the playback (play/pause/next) endpoints — free accounts get 403.
# IMPORTANT: because Spotify forces the 127.0.0.1 host, open the whole dashboard
# at http://127.0.0.1:3000 (NOT http://localhost:3000). Same origin = you stay
# logged in after connecting. For consistency, use the 127.0.0.1 host in the
# Google redirect URI above too, or set APP_BASE_URL to your canonical origin.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=https://your-app.com/api/spotify/callback

# --- Notifications (optional) ---
# Telegram is free + instant: message @BotFather → /newbot → copy the token.
# Then message your new bot once and read your chat id from:
#   https://api.telegram.org/bot<token>/getUpdates
# Without these, the daily brief + handoff alerts just print to the server console.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server ---
PORT=3000

# Daily agent run schedule (cron syntax). Default: 9:00 AM every day.
DAILY_CRON=0 9 * * *

# Let AYUS control the mouse & keyboard (Windows UIAutomation: ui_list/ui_click/
# ui_type/ui_key). OFF by default — this lets it operate the UI like a human,
# including bypassing the read-only file guard by typing. Set to 1 to enable.
COMPUTER_USE_ENABLED=1

# Second brain vault (the founder's markdown knowledge base).
# Only exists on his laptop; vault tools return "not available" if unset/missing.
VAULT_PATH=F:\ANISH
